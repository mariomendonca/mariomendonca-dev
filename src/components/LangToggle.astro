---
import type { Locale } from '../i18n/ui';
import { useTranslations, otherLocale, localeHome } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const target = otherLocale(locale);
---

<a class="lang" href={localeHome(target)} hreflang={target === 'pt' ? 'pt-BR' : 'en'} aria-label={t('a11y.lang')} data-lang-toggle>
  {target === 'pt' ? 'PT' : 'EN'}
</a>

<style>
  .lang {
    display: inline-grid;
    place-items: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding-inline: 0.5rem;
    border-radius: 8px;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .lang:hover { background: var(--wash); color: var(--ink); }
</style>

<script is:inline>
  document.querySelectorAll('[data-lang-toggle]').forEach((el) => {
    el.addEventListener('click', (e) => {
      const hash = window.location.hash;
      if (hash) {
        e.preventDefault();
        window.location.href = el.getAttribute('href') + hash;
      }
    });
  });
</script>
