---
import type { Locale } from '../i18n/ui';
import { useTranslations, otherLocale, localeHome } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const target = otherLocale(locale);
const href = localeHome(target);
---

<a class="lang-toggle" href={href} aria-label={t('a11y.lang')} data-lang-toggle>
  <span class={locale === 'en' ? 'on' : ''}>EN</span>
  <span class="sep">/</span>
  <span class={locale === 'pt' ? 'on' : ''}>PT</span>
</a>

<style>
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 2.4rem;
    padding-inline: 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .lang-toggle:hover { border-color: var(--ink); transform: translateY(-1px); }
  .lang-toggle .on { color: var(--ink); font-weight: 600; }
  .lang-toggle .sep { color: var(--line-strong); }
</style>

<script is:inline>
  // Preserve the current section anchor when switching language.
  document.querySelectorAll('[data-lang-toggle]').forEach((el) => {
    el.addEventListener('click', (e) => {
      const hash = window.location.hash;
      if (hash) {
        e.preventDefault();
        window.location.href = el.getAttribute('href') + hash;
      }
    });
  });
</script>
