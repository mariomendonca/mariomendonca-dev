---
import type { Locale } from '../i18n/ui';
import { useTranslations, pick } from '../i18n/ui';
import { skillGroups } from '../data/skills';
import { credentials } from '../data/education';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="section" id="skills">
  <div class="wrap split">
    <h2>{t('section.skills')}</h2>
    <dl class="rows">
      {skillGroups.map((g) => (
        <div class="row">
          <dt>{pick(g.category, locale)}</dt>
          <dd>{(Array.isArray(g.items) ? g.items : pick(g.items, locale)).join(', ')}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="section" id="education">
  <div class="wrap split">
    <h2>{t('section.education')}</h2>
    <dl class="rows">
      {credentials.map((c) => (
        <div class="row">
          <dt>{pick(c.period, locale)}</dt>
          <dd>
            <strong>{pick(c.title, locale)}</strong>
            <span>{c.institution}</span>
            {c.note && <p>{pick(c.note, locale)}</p>}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .rows { display: grid; }
  .row {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--rule);
  }
  .row:last-child { border-bottom: 1px solid var(--rule); }
  .row dt { font-size: var(--fs-sm); color: var(--ink-3); padding-top: 0.1rem; font-variant-numeric: tabular-nums; }
  .row dd { margin: 0; color: var(--ink-2); max-width: 62ch; }
  .row strong { display: block; color: var(--ink); font-weight: 500; }
  .row span { font-size: var(--fs-sm); color: var(--ink-3); }
  .row p { margin-top: 0.4rem; font-size: var(--fs-sm); }
  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
