---
import type { Locale } from '../i18n/ui';
import { useTranslations, pick } from '../i18n/ui';
import { experiences } from '../data/experience';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="section" id="experience">
  <div class="wrap split">
    <h2>{t('section.experience')}</h2>
    <ol class="jobs">
      {experiences.map((e) => (
        <li class="job">
          <p class="job__period">{pick(e.period, locale)}</p>
          <div>
            <h3 class="job__title">
              {pick(e.role, locale)} <span class="job__at">· {e.company}</span>
            </h3>
            <p class="job__loc">{pick(e.location, locale)}</p>
            <p class="job__summary">{pick(e.summary, locale)}</p>
            {pick(e.bullets, locale).length > 0 && (
              <ul class="job__bullets">
                {pick(e.bullets, locale).map((b) => <li>{b}</li>)}
              </ul>
            )}
            {e.tech.length > 0 && <p class="job__tech">{e.tech.join(', ')}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .jobs { list-style: none; padding: 0; }
  .job {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--rule);
  }
  .job:first-child { padding-top: 0.85rem; }
  .job:last-child { border-bottom: 1px solid var(--rule); }
  .job__period { font-size: var(--fs-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; padding-top: 0.15rem; }
  .job__title { font-size: var(--fs-md); letter-spacing: -0.01em; line-height: 1.35; }
  .job__at { color: var(--ink-2); font-weight: 500; }
  .job__loc { font-size: var(--fs-sm); color: var(--ink-3); }
  .job__summary { margin-top: 0.6rem; color: var(--ink-2); max-width: 65ch; }
  .job__bullets { margin-top: 0.75rem; padding-left: 1.1rem; display: grid; gap: 0.4rem; color: var(--ink-2); max-width: 65ch; }
  .job__bullets li::marker { color: var(--ink-3); }
  .job__tech { margin-top: 0.75rem; font-size: var(--fs-sm); color: var(--ink-3); }
  @media (max-width: 560px) {
    .job { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
