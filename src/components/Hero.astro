---
import type { Locale } from '../i18n/ui';
import { useTranslations, pick } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const socials = profile.socials.filter((s) => !s.href.startsWith('mailto'));
---

<section class="hero" id="top">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <h1 class="hero__name">{profile.name}</h1>
      <p class="hero__pitch">{pick(profile.tagline, locale)}</p>
      <p class="hero__now">{t('im.now')} {pick(profile.location, locale)}.</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={`mailto:${profile.email}`}>{t('hero.cta.contact')}</a>
        <a class="btn btn--quiet" href={profile.cv} download>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>
          {t('hero.cta.cv')}
        </a>
      </div>
      <ul class="hero__social">
        {socials.map((s) => <li><a class="link" href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
      </ul>
    </div>
    <img class="hero__photo" src={profile.photo} alt={profile.name} width="900" height="900" fetchpriority="high" />
  </div>
</section>

<style>
  .hero { padding-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem); }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .hero__name { font-size: var(--fs-xl); letter-spacing: -0.035em; line-height: 1; }
  .hero__pitch { font-size: var(--fs-lg); color: var(--ink); margin-top: 1.25rem; max-width: 30ch; line-height: 1.4; letter-spacing: -0.01em; }
  .hero__now { color: var(--ink-2); margin-top: 1rem; max-width: 52ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero__social { list-style: none; padding: 0; display: flex; gap: 1.25rem; margin-top: 1.5rem; font-size: var(--fs-sm); }
  .hero__photo {
    width: 100%;
    max-height: 32rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 28%;
    border-radius: var(--radius);
    background: var(--wash);
    animation: focus-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes focus-in { from { filter: blur(14px) saturate(0.6); } }

  @media (max-width: 760px) {
    .hero__grid { grid-template-columns: 1fr auto; align-items: start; gap: 1rem; }
    .hero__text { display: contents; }
    .hero__name { grid-column: 1; grid-row: 1; align-self: center; }
    .hero__photo { grid-column: 2; grid-row: 1; width: 5.5rem; height: 5.5rem; aspect-ratio: 1; border-radius: 50%; }
    .hero__pitch, .hero__now, .hero__actions, .hero__social { grid-column: 1 / -1; margin-top: 0; }
  }
</style>
