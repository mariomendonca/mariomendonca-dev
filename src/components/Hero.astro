---
import type { Locale } from '../i18n/ui';
import { useTranslations, pick } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="hero" id="top">
  <div class="wrap hero__inner">
    <div class="hero__text">
      <p class="eyebrow hero__eyebrow stagger" style="--d: 0ms">{t('hero.eyebrow')}</p>

      <h1 class="hero__name">
        <span class="stagger" style="--d: 80ms">Mario</span>
        <span class="stagger hero__last" style="--d: 160ms">Mendonça</span>
      </h1>

      <p class="hero__tagline stagger" style="--d: 260ms">{pick(profile.tagline, locale)}</p>

      <div class="hero__actions stagger" style="--d: 340ms">
        <a class="btn" href={`mailto:${profile.email}`}>
          {t('hero.cta.contact')}
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn btn--ghost" href={profile.cv} download>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 11l5 5 5-5M5 21h14"/></svg>
          {t('hero.cta.cv')}
        </a>
      </div>

      <div class="hero__meta stagger" style="--d: 420ms">
        <span class="hero__dot" aria-hidden="true"></span>
        {t('hero.available')}
        <span class="hero__loc">· {pick(profile.location, locale)}</span>
      </div>
    </div>

    <div class="hero__media stagger" style="--d: 220ms">
      <div class="hero__frame">
        <img src={profile.photo} alt={`${profile.name} — ${pick(profile.title, locale)}`} width="640" height="640" loading="eager" fetchpriority="high" />
      </div>
      <ul class="hero__stats">
        {profile.stats.map((s) => (
          <li>
            <strong>{s.value}</strong>
            <span>{pick(s.label, locale)}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 2rem + 8vw, 8rem) clamp(3rem, 2rem + 4vw, 5rem);
    overflow: hidden;
  }
  /* soft accent glow behind hero */
  .hero::before {
    content: '';
    position: absolute;
    top: -25%;
    right: -10%;
    width: 60vw;
    height: 60vw;
    max-width: 720px;
    max-height: 720px;
    background: radial-gradient(circle, var(--accent-soft), transparent 65%);
    pointer-events: none;
    z-index: 0;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.25fr 0.95fr;
    gap: clamp(2rem, 1rem + 5vw, 5rem);
    align-items: center;
  }

  .hero__eyebrow { margin-bottom: 1.5rem; }

  .hero__name {
    font-size: var(--step-5);
    line-height: 0.92;
    margin-bottom: 1.6rem;
  }
  .hero__name span { display: block; }
  .hero__last { color: var(--accent); }

  .hero__tagline {
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 30ch;
    line-height: 1.45;
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 1.6rem;
  }

  .hero__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #2bb673;
    box-shadow: 0 0 0 0 rgba(43, 182, 115, 0.5);
    animation: pulse 2.4s infinite;
  }
  .hero__loc { color: var(--ink-faint); }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(43, 182, 115, 0.45); }
    70% { box-shadow: 0 0 0 8px rgba(43, 182, 115, 0); }
    100% { box-shadow: 0 0 0 0 rgba(43, 182, 115, 0); }
  }

  /* Media */
  .hero__media { position: relative; }
  .hero__frame {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    aspect-ratio: 1 / 1;
    background: var(--bg-tint);
  }
  .hero__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.02) contrast(1.02);
  }
  .hero__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, color-mix(in srgb, var(--bg) 55%, transparent));
    pointer-events: none;
  }

  .hero__stats {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    text-align: center;
  }
  .hero__stats li {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.8rem 0.4rem;
    background: var(--surface);
  }
  .hero__stats strong {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1;
    color: var(--accent);
  }
  .hero__stats span {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink-faint);
    line-height: 1.3;
    display: block;
    margin-top: 0.4rem;
  }

  @media (max-width: 880px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__media { order: -1; max-width: 320px; }
    .hero__tagline { max-width: none; }
  }

  /* Staggered entrance */
  .stagger {
    opacity: 0;
    transform: translateY(16px);
    animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--d, 0ms);
  }
  @keyframes rise {
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stagger { opacity: 1; transform: none; animation: none; }
  }
</style>
