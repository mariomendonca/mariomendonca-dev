---
import type { Locale } from '../i18n/ui';
import { useTranslations, pick } from '../i18n/ui';
import { projects } from '../data/projects';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const featured = ['Zuno', 'Volta', 'Mind Eaters FC Dashboard'];
const shown = projects.filter((p) => featured.includes(p.name));
const rest = projects.filter((p) => !featured.includes(p.name));
const year = (s: string) => (s.match(/\d{4}/g) ?? []).slice(0, 1).join('');
---

<section class="section" id="work">
  <div class="wrap">
    <h2 class="work__title">{t('im.work')}</h2>
    <ul class="work">
      {shown.map((p) => (
        <li class="item">
          <a class="item__shot" href={p.links?.live} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
            <img src={p.images![0]} alt="" width="1440" height="900" loading="lazy" decoding="async" />
          </a>
          <div class="item__head">
            <h3><a href={p.links?.live} target="_blank" rel="noopener">{p.name}</a></h3>
            <span>{year(pick(p.period, 'en')) || pick(p.period, locale)}</span>
          </div>
          <p class="item__summary">{pick(p.summary, locale)}</p>
          <p class="item__desc">{pick(p.description, locale)}</p>
          <p class="item__tech">{p.tech.join(', ')}</p>
        </li>
      ))}
    </ul>

    {rest.length > 0 && (
      <dl class="also">
        {rest.map((p) => (
          <div class="also__row">
            <dt>
              <span class="also__name">{p.name}</span>
              <span class="also__when">{pick(p.period, locale)}</span>
            </dt>
            <dd>
              <p class="item__summary">{pick(p.summary, locale)}</p>
              <p class="item__desc">{pick(p.description, locale)}</p>
              <p class="item__tech">{p.tech.join(', ')}</p>
              {p.links?.live
                ? <a class="link also__link" href={p.links.live} target="_blank" rel="noopener">{t('im.visit')}</a>
                : <p class="item__tech">{t('im.offline')}</p>}
            </dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>

<style>
  .work__title { font-size: var(--fs-md); letter-spacing: -0.01em; margin-bottom: 1.5rem; }
  .work {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2.5rem, 2rem + 2vw, 4rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .item__shot {
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--wash);
    outline: 1px solid var(--rule);
    outline-offset: -1px;
    margin-bottom: 1.1rem;
  }
  .item__shot img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: top;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .item:hover .item__shot img { transform: scale(1.02); }
  .item__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .item__head h3 { font-size: var(--fs-md); letter-spacing: -0.01em; }
  .item__head h3 a { text-decoration: none; }
  .item__head h3 a:hover { color: var(--accent); }
  .item__head span { font-size: var(--fs-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .item__summary { margin-top: 0.35rem; }
  .item__desc { margin-top: 0.5rem; color: var(--ink-2); font-size: var(--fs-sm); max-width: 62ch; }
  .item__tech { margin-top: 0.6rem; color: var(--ink-3); font-size: var(--fs-sm); }

  .also { margin-top: clamp(3rem, 2.5rem + 2vw, 4.5rem); }
  .also__row {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 2rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .also__row:last-child { border-bottom: 1px solid var(--rule); }
  .also__row dt { display: grid; gap: 0.15rem; align-content: start; }
  .also__name { font-weight: 600; letter-spacing: -0.01em; }
  .also__when { font-size: var(--fs-sm); color: var(--ink-3); }
  .also__row dd { margin: 0; max-width: 65ch; }
  .also__row .item__summary { margin-top: 0; }
  .also__link { display: inline-block; margin-top: 0.6rem; font-size: var(--fs-sm); }

  @media (max-width: 960px) {
    .work { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .work, .also__row { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
