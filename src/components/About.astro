---
import type { Locale } from '../i18n/ui';
import { useTranslations, pick } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="section" id="about">
  <div class="wrap split">
    <h2>{t('section.about')}</h2>
    <div class="about">
      {profile.about.map((p) => <p>{pick(p, locale)}</p>)}
    </div>
  </div>
</section>

<style>
  .about { display: grid; gap: 1rem; max-width: 65ch; color: var(--ink-2); }
  .about p:first-child { color: var(--ink); font-size: var(--fs-md); }
</style>
